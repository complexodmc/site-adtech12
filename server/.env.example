# =============================================================
# COMPLEXO DMC · API — variáveis de ambiente
# Copie para .env e preencha. O .env NÃO vai para o git.
# =============================================================

# Connection string do MongoDB Atlas (inclui usuário e senha)
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net"

# Nome do banco dentro do cluster
MONGODB_DB="complexodmc"
# Tempo máximo (ms) para localizar o servidor Mongo antes de falhar. Padrão: 5000 na
# Vercel (função de 10 s: banco fora vira 503 de contato/newsletter, não 504), 15000 fora.
# Se a MONGODB_URI já trouxer ?serverSelectionTimeoutMS=, a URI prevalece.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Segredo de assinatura dos tokens JWT.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do token de sessão
JWT_EXPIRES_IN="7d"

# Porta do servidor
PORT=3000

# Origens permitidas no CORS, separadas por vírgula.
# Vazio = mesma origem apenas (o servidor já entrega o site estático).
CORS_ORIGINS=""

# Habilita a rota POST /api/dev/simular-pagamento (auto-liberação de cursos).
# DEIXE "false" EM PRODUÇÃO.
DEV_SIMULAR_PAGAMENTO="false"

# Onde ficam os PDFs de material de apoio das aulas.
# Vazio = server/uploads. Precisa ser um diretório persistente (fora do deploy
# se o servidor recria a pasta a cada publicação).
UPLOADS_DIR=""

# Tamanho máximo de cada PDF enviado no painel administrativo, em MB.
MAX_UPLOAD_MB=25

# Proxies confiáveis à frente do Express, para o req.ip (throttle por IP).
# Vazio = automático: 1 na Vercel (VERCEL=1), nenhum fora dela.
# Só preencha se houver outro proxy reverso (ex.: "1", "loopback").
TRUST_PROXY=""

# ---------- Formulário de contato (POST /api/contato) ----------
# Aviso por e-mail a cada lead, via API HTTP do Resend (https://resend.com),
# sem dependência extra. Opcional: com RESEND_API_KEY ou LEADS_EMAIL_TO vazios,
# o lead é só gravado na coleção "leads" e registrado no log.
RESEND_API_KEY=""
# Destinatários do aviso, separados por vírgula.
LEADS_EMAIL_TO=""
# Remetente. Precisa ser de um domínio verificado no Resend
# (ex.: "Site Complexo DMC <site@complexodmc.com.br>"). Vazio = onboarding@resend.dev,
# que o Resend só entrega para o e-mail dono da conta (serve para teste).
LEADS_EMAIL_FROM=""

# ---------- Candidaturas de parceria (POST /api/parcerias/*) ----------
# Destinatários do aviso de nova candidatura (Partner Lawyers / Business Partner),
# separados por vírgula. Usa o mesmo RESEND_API_KEY e LEADS_EMAIL_FROM acima.
# Vazio = cai em LEADS_EMAIL_TO; sem nenhum dos dois (ou sem RESEND_API_KEY),
# a candidatura é só gravada em "parcerias_candidaturas" e registrada no log.
# PARCERIAS_EMAIL_TO=""

# ---------- Concurso de Bolsas (POST /api/bolsas/pre-inscricao) ----------
# Destinatários do aviso de nova pré-inscrição, separados por vírgula. Usa o mesmo
# RESEND_API_KEY e LEADS_EMAIL_FROM acima. Vazio = cai em LEADS_EMAIL_TO; sem nenhum
# dos dois (ou sem RESEND_API_KEY), a pré-inscrição é só gravada em
# "bolsas_preinscricoes" e registrada no log.
# BOLSAS_EMAIL_TO=""

# ---------- Newsletter (POST /api/newsletter) ----------
# Versão/data da Política de Privacidade vigente, gravada em cada consentimento.
# Atualize quando a política mudar. Ex.: "2026-10-17". Vazio = "nao-informada":
# fora de produção só avisa no log; com NODE_ENV=production (Vercel) a inscrição
# é RECUSADA com 503 até a variável existir (consentimento sem versão não prova nada).
NEWSLETTER_POLITICA_VERSAO=""
# "true" grava o IP truncado (IPv4 /24, IPv6 /48) no registro de consentimento.
# Padrão: desligado (ipTruncado = null), porque a Política de Privacidade publicada
# afirma que o IP não é gravado. Só ligue depois de publicar a política corrigida.
NEWSLETTER_GRAVAR_IP="false"
# Origens extras (Origin/Referer) aceitas no descadastro por e-mail, separadas por
# vírgula. complexodmc.com.br, www e CORS_ORIGINS já entram; localhost entra fora
# da Vercel. Pedido com Origin de outro site → 403 (CSRF).
# NEWSLETTER_ORIGENS=""

# "true" envia aviso interno por inscrição (usa RESEND_API_KEY/LEADS_EMAIL_FROM). Padrão: desligado.
NEWSLETTER_NOTIFICAR="false"
# Destinatários do aviso, separados por vírgula; vazio = LEADS_EMAIL_TO.
NEWSLETTER_EMAIL_TO=""
# Os links de descadastro são assinados com o JWT_SECRET acima (HMAC-SHA256).
# Trocar o segredo invalida os links já enviados; o descadastro por e-mail continua.

# ---------- Portal acadêmico · Assistente de IA (Google Gemini) ----------
# Opcional. Com a variável definida, ela vale sobre a chave colada pela coordenação
# em Portal do professor › Configurações › Assistente de IA, e o painel não troca a
# chave (responde 409). Sem ela, a chave é colada no painel e guardada CIFRADA
# (AES-256-GCM, chave derivada do JWT_SECRET) — a API nunca a devolve, só os 4
# últimos caracteres. Troque o JWT_SECRET ANTES de colar a chave (incidente T3).
# GEMINI_API_KEY=""
# Prazo total de uma resposta do assistente, em ms (1000 a 120000). Vazio ou fora
# da faixa = 8 s na Vercel e 20 s fora dela.
# PORTAL_IA_TIMEOUT_MS=""
# PORTAL_GEMINI_URL, PORTAL_VIACEP_URL e PORTAL_RESEND_URL são SÓ para QA (o
# tests/server/serve.mjs aponta para provedores falsos locais); com VERCEL_ENV
# presente são ignoradas, com aviso no log. Não defina em produção.

# ---------- Portal acadêmico · demais variáveis (server/src/portal/config-portal.js) ----------
# Lidas SÓ em config-portal.js (o config.js legado não muda). Avisos no log do boot dizem o nome
# da variável e o estado, nunca o valor. Especificação: docs/dmc/PORTAL-API.md §11.
#
# JWT_SECRET (acima) também é o material do HKDF do portal: cifra da chave do Gemini e do 2FA,
# selo HMAC de declarações/frequência/avaliações/contratos e HMAC de identificadores. Trocar o
# segredo invalida o que foi cifrado ou selado com o anterior (ver PORTAL_MATERIAL_ANTERIOR).
#
# Base absoluta dos links enviados por e-mail (link de acesso, nova senha, troca de e-mail) e do
# QR dos documentos. Em produção: obrigatória e https (ex.: "https://complexodmc.com.br"); nunca
# é deduzida do cabeçalho Host. Na Vercel sem ela, os fluxos por link ficam indisponíveis; fora
# da Vercel o padrão é http://localhost:<PORT>.
# PORTAL_BASE_URL=""
#
# E-mail transacional do portal: usa o MESMO RESEND_API_KEY do formulário de contato (acima).
# Remetente de domínio VERIFICADO no Resend (ex.: "Plataforma Complexo DMC
# <nao-responda@complexodmc.com.br>"); vazio = LEADS_EMAIL_FROM. Sem RESEND_API_KEY ou sem
# remetente: link de acesso, recuperação de senha e troca de e-mail respondem 503
# "email-indisponivel" e as telas mostram o caminho alternativo (senha temporária pela coordenação).
# PORTAL_EMAIL_FROM=""
#
# Teto, em MB, dos PDFs de material de apoio do portal e de publicações e dos documentos pessoais
# e contratos (estes dois nunca acima de 4). Padrão 4; com VERCEL=1 nunca passa de 4 (corpo da
# função ≤ 4,5 MB). Fixos no código: foto do perfil 2 MB, capa e banner 1 MB, 2ª via e TCC 4 MB.
# PORTAL_MAX_ARQUIVO_MB=4
#
# "1" libera a ATIVAÇÃO da verificação em duas etapas e a torna obrigatória para a coordenação
# em /portal/admin e /portal/professor. DEIXE AUSENTE até o login da sessão 2d ter o passo do
# código provado por tests/e2e/login-portal.spec.js (índice §9.9 item 1a) — ligar antes tranca a
# coordenação fora do login novo.
# PORTAL_2FA=""
#
# Janela de rotação do JWT_SECRET: o segredo ANTERIOR, aceito só para decifrar (2FA, chave do
# Gemini) e verificar selos; o que for decifrado é regravado com o atual. Tire depois de 90 dias.
# Na troca do incidente T3 NÃO use: o segredo antigo está comprometido e a troca acontece antes
# de qualquer dado cifrado ou selado em produção.
# PORTAL_MATERIAL_ANTERIOR=""
#
# "1" liga o modo estrito fora de produção (módulo do portal ausente vira console.error e aparece
# no painel). Na Vercel e com NODE_ENV=production já é estrito.
# PORTAL_MODULOS_ESTRITO=""
#
# ---------- SÓ QA — nunca defina em produção nem na Vercel ----------
# Valem apenas com QA_SERVIDOR=1, VERCEL_ENV ausente e NODE_ENV diferente de production (regra
# D-41); fora disso são IGNORADAS, com aviso no log. Quem define é o tests/server/serve.mjs.
# QA_SERVIDOR=""                # "1" liga a regra de QA (só o serve.mjs)
# PORTAL_MODULOS=""             # caminhos de módulo a montar no E2E por fatia (os 9 da F0t sobem junto)
# PORTAL_MODULOS_IGNORAR=""     # caminhos de módulo a pular no E2E por fatia
# PORTAL_GEMINI_URL=""          # provedor falso, só http://127.0.0.1:<porta>
# PORTAL_VIACEP_URL=""          # idem (CEP)
# PORTAL_RESEND_URL=""          # idem (e-mail; mensagens em GET /__qa/emails)
# Só testes de servidor (nunca no servidor): PORTAL_TESTE_MONGO_URI (mongodb:// em 127.0.0.1) e
# PORTAL_TESTE_MONGO_DB (terminado em _qa) habilitam server/test/portal-base-integracao.test.js.
# Só no serve.mjs: QA_GEMINI_API_KEY (a GEMINI_API_KEY do shell nunca entra no QA).
