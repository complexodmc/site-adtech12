# =============================================================
# COMPLEXO DMC · API — variáveis de ambiente
# Copie para .env e preencha. O .env NÃO vai para o git.
# =============================================================

# Connection string do MongoDB Atlas (inclui usuário e senha)
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net"

# Nome do banco dentro do cluster
MONGODB_DB="complexodmc"
# Tempo máximo (ms) para localizar o servidor Mongo antes de falhar. Padrão: 5000 na
# Vercel (função de 10 s: banco fora vira 503 de contato/newsletter, não 504), 15000 fora.
# Se a MONGODB_URI já trouxer ?serverSelectionTimeoutMS=, a URI prevalece.
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Segredo de assinatura dos tokens JWT.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do token de sessão
JWT_EXPIRES_IN="7d"

# Porta do servidor
PORT=3000

# Origens permitidas no CORS, separadas por vírgula.
# Vazio = mesma origem apenas (o servidor já entrega o site estático).
CORS_ORIGINS=""

# Habilita a rota POST /api/dev/simular-pagamento (auto-liberação de cursos).
# DEIXE "false" EM PRODUÇÃO.
DEV_SIMULAR_PAGAMENTO="false"

# Onde ficam os PDFs de material de apoio das aulas.
# Vazio = server/uploads. Precisa ser um diretório persistente (fora do deploy
# se o servidor recria a pasta a cada publicação).
UPLOADS_DIR=""

# Tamanho máximo de cada PDF enviado no painel administrativo, em MB.
MAX_UPLOAD_MB=25

# Proxies confiáveis à frente do Express, para o req.ip (throttle por IP).
# Vazio = automático: 1 na Vercel (VERCEL=1), nenhum fora dela.
# Só preencha se houver outro proxy reverso (ex.: "1", "loopback").
TRUST_PROXY=""

# ---------- Formulário de contato (POST /api/contato) ----------
# Aviso por e-mail a cada lead, via API HTTP do Resend (https://resend.com),
# sem dependência extra. Opcional: com RESEND_API_KEY ou LEADS_EMAIL_TO vazios,
# o lead é só gravado na coleção "leads" e registrado no log.
RESEND_API_KEY=""
# Destinatários do aviso, separados por vírgula.
LEADS_EMAIL_TO=""
# Remetente. Precisa ser de um domínio verificado no Resend
# (ex.: "Site Complexo DMC <site@complexodmc.com.br>"). Vazio = onboarding@resend.dev,
# que o Resend só entrega para o e-mail dono da conta (serve para teste).
LEADS_EMAIL_FROM=""

# ---------- Candidaturas de parceria (POST /api/parcerias/*) ----------
# Destinatários do aviso de nova candidatura (Partner Lawyers / Business Partner),
# separados por vírgula. Usa o mesmo RESEND_API_KEY e LEADS_EMAIL_FROM acima.
# Vazio = cai em LEADS_EMAIL_TO; sem nenhum dos dois (ou sem RESEND_API_KEY),
# a candidatura é só gravada em "parcerias_candidaturas" e registrada no log.
# PARCERIAS_EMAIL_TO=""

# ---------- Concurso de Bolsas (POST /api/bolsas/pre-inscricao) ----------
# Destinatários do aviso de nova pré-inscrição, separados por vírgula. Usa o mesmo
# RESEND_API_KEY e LEADS_EMAIL_FROM acima. Vazio = cai em LEADS_EMAIL_TO; sem nenhum
# dos dois (ou sem RESEND_API_KEY), a pré-inscrição é só gravada em
# "bolsas_preinscricoes" e registrada no log.
# BOLSAS_EMAIL_TO=""

# ---------- Newsletter (POST /api/newsletter) ----------
# Versão/data da Política de Privacidade vigente, gravada em cada consentimento.
# Atualize quando a política mudar. Ex.: "2026-10-17". Vazio = "nao-informada":
# fora de produção só avisa no log; com NODE_ENV=production (Vercel) a inscrição
# é RECUSADA com 503 até a variável existir (consentimento sem versão não prova nada).
NEWSLETTER_POLITICA_VERSAO=""
# "true" grava o IP truncado (IPv4 /24, IPv6 /48) no registro de consentimento.
# Padrão: desligado (ipTruncado = null), porque a Política de Privacidade publicada
# afirma que o IP não é gravado. Só ligue depois de publicar a política corrigida.
NEWSLETTER_GRAVAR_IP="false"
# Origens extras (Origin/Referer) aceitas no descadastro por e-mail, separadas por
# vírgula. complexodmc.com.br, www e CORS_ORIGINS já entram; localhost entra fora
# da Vercel. Pedido com Origin de outro site → 403 (CSRF).
# NEWSLETTER_ORIGENS=""

# "true" envia aviso interno por inscrição (usa RESEND_API_KEY/LEADS_EMAIL_FROM). Padrão: desligado.
NEWSLETTER_NOTIFICAR="false"
# Destinatários do aviso, separados por vírgula; vazio = LEADS_EMAIL_TO.
NEWSLETTER_EMAIL_TO=""
# Os links de descadastro são assinados com o JWT_SECRET acima (HMAC-SHA256).
# Trocar o segredo invalida os links já enviados; o descadastro por e-mail continua.
