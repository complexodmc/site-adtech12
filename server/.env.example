# =============================================================
# COMPLEXO DMC · API — variáveis de ambiente
# Copie para .env e preencha. O .env NÃO vai para o git.
# =============================================================

# Connection string do MongoDB Atlas (inclui usuário e senha)
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net"

# Nome do banco dentro do cluster
MONGODB_DB="complexodmc"

# Segredo de assinatura dos tokens JWT.
# Gere um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do token de sessão
JWT_EXPIRES_IN="7d"

# Porta do servidor
PORT=3000

# Origens permitidas no CORS, separadas por vírgula.
# Vazio = mesma origem apenas (o servidor já entrega o site estático).
CORS_ORIGINS=""

# Habilita a rota POST /api/dev/simular-pagamento (auto-liberação de cursos).
# DEIXE "false" EM PRODUÇÃO.
DEV_SIMULAR_PAGAMENTO="false"

# Onde ficam os PDFs de material de apoio das aulas.
# Vazio = server/uploads. Precisa ser um diretório persistente (fora do deploy
# se o servidor recria a pasta a cada publicação).
UPLOADS_DIR=""

# Tamanho máximo de cada PDF enviado no painel administrativo, em MB.
MAX_UPLOAD_MB=25

# Proxies confiáveis à frente do Express, para o req.ip (throttle por IP).
# Vazio = automático: 1 na Vercel (VERCEL=1), nenhum fora dela.
# Só preencha se houver outro proxy reverso (ex.: "1", "loopback").
TRUST_PROXY=""

# ---------- Formulário de contato (POST /api/contato) ----------
# Aviso por e-mail a cada lead, via API HTTP do Resend (https://resend.com),
# sem dependência extra. Opcional: com RESEND_API_KEY ou LEADS_EMAIL_TO vazios,
# o lead é só gravado na coleção "leads" e registrado no log.
RESEND_API_KEY=""
# Destinatários do aviso, separados por vírgula.
LEADS_EMAIL_TO=""
# Remetente. Precisa ser de um domínio verificado no Resend
# (ex.: "Site Complexo DMC <site@complexodmc.com.br>"). Vazio = onboarding@resend.dev,
# que o Resend só entrega para o e-mail dono da conta (serve para teste).
LEADS_EMAIL_FROM=""

# ---------- Candidaturas de parceria (POST /api/parcerias/*) ----------
# Destinatários do aviso de nova candidatura (Partner Lawyers / Business Partner),
# separados por vírgula. Usa o mesmo RESEND_API_KEY e LEADS_EMAIL_FROM acima.
# Vazio = cai em LEADS_EMAIL_TO; sem nenhum dos dois (ou sem RESEND_API_KEY),
# a candidatura é só gravada em "parcerias_candidaturas" e registrada no log.
# PARCERIAS_EMAIL_TO=""
