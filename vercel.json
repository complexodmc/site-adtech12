{
  "version": 2,
  "outputDirectory": "complexodmc.com.br",
  "functions": {
    "api/[...path].js": {
      "excludeFiles": "complexodmc.com.br/**"
    }
  },
  "redirects": [
    {
      "source": "/server/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/complexodmc.com.br/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/complexodmc.com.br",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/complexodmc.com.br/(.*)",
      "destination": "/$1",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/em-construcao.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pages/planejamento-sucessorio-empresarial.html",
      "destination": "/pages/planejamento-sucessorio.html",
      "statusCode": 301
    },
    {
      "source": "/pages/Sobre.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pages/Apresenta%C3%A7%C3%A3o.html",
      "destination": "/pages/consultoria-imobiliaria.html",
      "statusCode": 301
    },
    {
      "source": "/pages/Consultoria%20Imobiili%C3%A1ria.html",
      "destination": "/pages/consultoria-imobiliaria.html",
      "statusCode": 301
    },
    {
      "source": "/pages/Jur%C3%ADdico%20Imobili%C3%A1rio.html",
      "destination": "/pages/juridico-imobiliario.html",
      "statusCode": 301
    },
    {
      "source": "/pages/Jur%C3%ADdico%20Vendas.html",
      "destination": "/pages/juridico-vendas.html",
      "statusCode": 301
    },
    {
      "source": "/solucoes/consultoria-trabalhista/defesa-e-capital",
      "destination": "/solucoes/consultoria-trabalhista/defesa-empresarial",
      "statusCode": 301
    },
    {
      "source": "/solucoes/consultoria-trabalhista",
      "destination": "/solucoes/consultoria-trabalhista/ciclo-fechado",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/solucoes/:vertical/:slug([a-z0-9-]+)",
      "destination": "/solucoes/:vertical/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' blob: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
